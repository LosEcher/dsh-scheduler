{
  "name": "dsh-scheduler",
  "version": "0.2.0",
  "description": "DSH 定时任务插件：cron/interval/once 触发器持久化存储，headless 独立进程执行，运行台账 + 会话内管理页（host 半包 /scheduler API + client 半包 conversation.view tab）。",
  "private": true,
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --preserve-symlinks --test 'test/*.test.mjs'"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "lib/client.js",
    "lib/cron-next.mjs",
    "lib/store.mjs",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/schemastery": ">=4.0.0"
  }
}
